+SseTransport::~SseTransport() {
+    finished_.store(true, std::memory_order_release);
+    if (watchdog_.joinable()) { watchdog_.join(); }
+}
+
+void SseTransport::run_watchdog() noexcept {
+    // Only meaningful when the socket exposes a liveness probe (SSE over a real connection).
+    // is_writable is read-only here - never write() from this thread, the worker owns the stream.
+    if (!sink_.is_writable) { return; }
+    watchdog_ = std::thread([this] {
+        while (!finished_.load(std::memory_order_acquire) &&
+               !cancelled_.load(std::memory_order_acquire)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(500));
+            if (finished_.load(std::memory_order_acquire) ||
+                cancelled_.load(std::memory_order_acquire)) {
+                break;
+            }
+            if (!sink_.is_writable()) { mark_cancelled(); break; }
+        }
+    });
+}
